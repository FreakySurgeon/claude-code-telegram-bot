[Unit]
Description=Claude Code Telegram Bot
After=network.target

[Service]
Type=simple
User=thomas
WorkingDirectory=/home/thomas/projects/claude-code-telegram-bot
ExecStart=/home/thomas/projects/claude-code-telegram-bot/.venv/bin/uvicorn claude_telegram.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
Environment=PATH=/home/thomas/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
