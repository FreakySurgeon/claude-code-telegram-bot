# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Claude Configuration
CLAUDE_CLI_PATH=claude
CLAUDE_WORKING_DIR=/path/to/your/project

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Mode: "tunnel" (default, auto-creates public URL), "polling" (no URL needed), or "webhook" (manual URL)
MODE=tunnel

# Webhook settings (only needed if MODE=webhook)
WEBHOOK_PATH=/webhook
WEBHOOK_URL=https://your-public-url.com

# Hook Configuration (for hook.py)
HOOK_SERVER_URL=http://localhost:8000

# LLM fallback chain for interactive sessions (Claude -> DeepSeek)
# DeepSeek = the same Claude CLI pointed at DeepSeek's Anthropic-compatible endpoint.
# The API key is read at runtime from this file; never put the key itself here.
LLM_INTERACTIVE_CHAIN=claude,deepseek
DEEPSEEK_API_KEY_FILE=~/.claude/deepseekapikey
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash
# Isolated Claude config dir for DeepSeek runs (no plugins / global memory)
CLAUDE_SLIM_CONFIG_DIR=~/.claude-slim
# Cooldown state shared with the pipelines (default: data/llm-provider-state.json)
LLM_PROVIDER_STATE_PATH=

# Channel routing (see routing.example.yaml). Unset = everything to Telegram.
CHANNEL_ROUTING_PATH=
# Optional dotenv file used to expand ${VAR} in the routing file (not exported)
CHANNEL_ENV_FILE=
# Runtime state directory (defaults to $GTD_WORKING_DIR/data)
DATA_DIR=
